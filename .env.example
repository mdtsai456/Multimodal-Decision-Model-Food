ZEABUR_AI_HUB_API_KEY=sk-your-key-here
ZEABUR_AI_HUB_BASE_URL=https://hnd1.aihub.zeabur.ai/
AI_MODEL=gpt-5.6-luna
# chat：看圖對話。jev：typesafe/jev-1.14 決策。單次請求可用表單 engine 覆寫
INFERENCE_ENGINE=chat
JEV_MODEL=typesafe/jev-1.14
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Jev 的 Noul 低於這個值就當這道菜不在盤上
NOUL_PRESENT_MIN=0.50
ADMIN_PASSWORD=admin123
SECRET_KEY=change-this-secret-key
# 兩道候選信心差 ≤ 此值時視為相近（前端雙條、後端 result1/result2）
CLOSE_CONFIDENCE_DELTA=0.30
# bbox 垂直微調（相對圖高；正＝往下，負＝往上，0＝不調）
# 若只設 BBOX_Y_SHIFT，上／下排都用同一值（相容舊設定）
BBOX_Y_SHIFT=0.06
# 分開調時覆寫上面的整體值，例如：
# BBOX_TOP_Y_SHIFT=0.02
# BBOX_BOTTOM_Y_SHIFT=0.08
